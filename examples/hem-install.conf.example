# ============================================================================
# نمونه فایل پیکربندی نصب — Headscale Easy Manager
# ---------------------------------------------------------------------------
# این فایل برای «حالت خودکار» (non-interactive) نصب استفاده می‌شود:
#     sudo ./install.sh --config /path/to/hem-install.conf --non-interactive
#
# ⚠️ امنیت: این فایل شامل پاسخ‌های نصب است؛ آن را با دسترسی 600 نگه دارید:
#     chmod 600 hem-install.conf
# و هرگز آن را در مخزن عمومی commit نکنید (این نسخه فقط نمونه است).
# ============================================================================

# --- عمومی -----------------------------------------------------------------
# حالت غیرتعاملی: هیچ سؤالی پرسیده نمی‌شود و مقادیر همین فایل اعتبارسنجی و
# استفاده می‌شوند. اگر مقدار اجباری نامعتبر باشد، نصب با کد خطا متوقف می‌شود.
non_interactive: true

# مسیر نصب ابزار (پیش‌فرض: /opt/headscale-easy-manager)
install_dir: /opt/headscale-easy-manager

# --- دامنه و HTTPS (اجباری) --------------------------------------------------
# دامنه‌ای که رکورد A آن به IP عمومی این سرور اشاره می‌کند.
# مثال: headscale.example.com
domain: ""

# آدرس ایمیل برای صدور گواهی Let's Encrypt (برای اطلاع انقضا؛ اختیاری ولی توصیه‌شده)
acme_email: ""

# --- Headscale ----------------------------------------------------------------
# نسخه مورد نصب. خالی = آخرین نسخه پایدار از GitHub (با بازگشت به نسخه پین‌شده 0.29.5)
headscale_version: ""

# نام اولین کاربر شبکه که ساخته می‌شود (مثال: admin)
first_user: "admin"

# دامنه MagicDNS — باید با «domain» متفاوت باشد (مثال: ts.example.com)
magic_dns_base: ""

# سرورهای DNS عمومی شبکه (پیش‌فرض: Cloudflare و Google)
dns_nameservers:
  - 1.1.1.1
  - 8.8.8.8

# --- DERP (Relay تعبیه‌شده) ----------------------------------------------------
# فعال‌سازی سرور DERP روی همین VPS (نیازمند HTTPS و پورت UDP 3478).
# توصیه: true — کیفیت اتصال در شبکه‌های سخت‌تر را بهتر می‌کند.
embedded_derp: true

# --- Reverse Proxy ---------------------------------------------------------------
# caddy :
#   install  → نصب Caddy جدید از مخزن رسمی (اگر نبود)
#   reuse    → استفاده از Caddy موجود (بلوک سایت اضافه می‌شود، بقیه دست‌نخورده)
#   skip     → هیچ پروکسی‌ای تنظیم نمی‌شود (فقط برای تست — توصیه نمی‌شود)
caddy: install

# --- فایروال ---------------------------------------------------------------------
# فعال‌سازی UFW با قواعد حداقلی (SSH فعلی همیشه مجاز نگه داشته می‌شود)
firewall: true

# پورت SSH در صورت غیرپیش‌فرض بودن (خالی = تشخیص خودکار از sshd)
ssh_port: ""

# --- دوربین‌های مداربسته (اختیاری — پس از نصب هم با «hsctl cameras add» شدنی است) ---
cameras: []
#  - name: "nvr-daftar"
#    host: "192.168.1.108"     # IP داخلی دستگاه ضبط در شبکه دفتر
#    http_port: 80             # پورت وب مدیریتی (اگر می‌دانید)
#    rtsp_port: 554            # پورت RTSP (اگر می‌دانید)
#    brand: "dahua"
