# ============================================================================
# نمونهٔ Canonical فایل پیکربندی نصب — Headscale Easy Manager
# ---------------------------------------------------------------------------
# این فایل «منبع واحد» نمونهٔ تنظیمات است؛ کلیدها عیناً مطابق parser واقعی
# (src/hem/installer/answers.py — کلاس InstallAnswers) و با مقدار معتبر.
# تست CI (tests/test_config_samples.py) تضمین می‌کند این فایل همیشه معتبر بماند.
#
# استفاده (حالت خودکار):
#     cp examples/hem-install.conf.example hem-install.conf
#     chmod 600 hem-install.conf          # این فایل شامل پاسخ‌های نصب است؛ محافظت کنید
#     sudo ./install.sh --config ./hem-install.conf --non-interactive --yes
#
# ⚠️ در حالت غیرتعاملی، اجرای برنامهٔ تغییرات نیازمند --yes صریح است؛
#     وجود همین فایل پیکربندی «رضایت ضمنی» تلقی نمی‌شود.
# ============================================================================

# --- عمومی -----------------------------------------------------------------
# حالت غیرتعاملی: هیچ سؤالی پرسیده نمی‌شود و مقادیر همین فایل اعتبارسنجی و
# استفاده می‌شوند. مقدار نامعتبر = توقف نصب با کد خطا (فرو داده نمی‌شود).
non_interactive: true

# مسیر نصب ابزار روی سرور (پیش‌فرض: /opt/headscale-easy-manager)
install_dir: /opt/headscale-easy-manager

# --- دامنه و گواهی (اجباری) ---------------------------------------------------
# دامنه‌ای که رکورد A آن به IP عمومی این سرور اشاره می‌کند (FQDN).
domain: headscale.example.com

# ایمیل برای صدور گواهی Let's Encrypt (اطلاع از انقضا؛ اختیاری ولی توصیه‌شده)
acme_email: ""

# --- Headscale ----------------------------------------------------------------
# نسخهٔ مورد نصب. خالی = آخرین نسخهٔ پایدار GitHub (با بازگشت به نسخهٔ پین‌شده).
headscale_version: "0.29.5"

# نام اولین کاربری که ساخته می‌شود (بدون فاصله)
first_user: admin

# دامنهٔ MagicDNS — الزامی و باید با «domain» متفاوت باشد (قید رسمی Headscale)
magic_dns_base: ts.example.com

# سرورهای DNS عمومی شبکه (باید IP معتبر باشند)
dns_nameservers:
  - 1.1.1.1
  - 8.8.8.8

# --- Reverse Proxy --------------------------------------------------------------
# حالت Caddy — فقط یکی از این سه مقدار:
#   install → نصب Caddy جدید از مخزن رسمی (توصیه‌شده)
#   reuse   → استفاده از Caddy موجود (فقط بلوک سایت ما اضافه می‌شود)
#   skip    → بدون پروکسی — فقط برای تست؛ HTTPS خاموش می‌شود
# (کلید جایگزین قدیمی «caddy:» نیز پذیرفته می‌شود؛ مقدار باید همین سه مورد باشد)
caddy_mode: install

# سرور DERP تعبیه‌شده روی همین VPS (نیازمند HTTPS؛ با caddy_mode: skip خاموش شود)
embedded_derp: true

# --- فایروال ---------------------------------------------------------------------
# فعال‌سازی UFW با قواعد حداقلی (پورت SSH فعلی همیشه اول مجاز می‌شود)
firewall: true

# پورت SSH سرور؛ خالی = تشخیص خودکار (از sshd)
ssh_port: ""

# --- دوربین‌های مداربسته (اختیاری — پس از نصب هم با «hsctl cameras add» شدنی است) ---
cameras: []
#  - name: "nvr-daftar"
#    host: "192.168.1.108"     # IP داخلی دستگاه ضبط در شبکهٔ دفتر
#    http_port: 80             # پورت وب مدیریتی (اگر می‌دانید)
#    rtsp_port: 554            # پورت RTSP (اگر می‌دانید)
#    brand: "dahua"

# ----------------------------------------------------------------------------
# نکته دربارهٔ کلیدهای «غیرقابل تنظیم از این فایل»:
#   • server_url به‌صورت خودکار از domain و caddy_mode ساخته می‌شود
#     (https://domain در حالت install/reuse و http://domain:8080 در حالت skip).
#   • magic_dns در config.yaml واقعی همیشه true است؛ از این فایل قابل تغییر نیست
#     (کلید قدیمی «magic_dns:» و «caddy_mode: install_new» وجود ندارند — نامعتبرند).
#   • پیشوندهای IP تونل (100.64.0.0/10 و fd7a:115c:a1e0::/48) توسط قالب رسمی
#     Headscale تعیین می‌شوند و کلید «ip_prefixes» وجود ندارد.
#   • dry_run کلید اجرایی است (نه پاسخ نصب) و معمولاً از CLI با --dry-run داده می‌شود.
