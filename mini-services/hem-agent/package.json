{
  "name": "hem-agent",
  "private": true,
  "version": "0.3.0",
  "description": "HEM Agent — real SSH management backend for Headscale Easy Manager (Persian product)",
  "scripts": {
    "dev": "bun --hot index.ts",
    "test": "bun test --timeout 120000",
    "start": "bun index.ts",
    "desktop": "bun index.ts --desktop",
    "typecheck": "tsc --noEmit",
    "test-server": "bun run test/server.ts",
    "package:windows": "bash packaging/build-windows.sh"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2",
    "socket.io-client": "^4.8.4"
  }
}
